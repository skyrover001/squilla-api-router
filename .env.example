# --- Router service ---
ROUTER_API_KEY=router-local-key-001

# ===========================================================================
# Provider / Tier 自动发现（无需改代码）
#
# 1. Provider：任何 <前缀>_BASE_URL 都会自动注册一个 provider（前缀小写，
#    特殊前缀 BACKEND_ 别名 tianhe）。VISION_ / ROUTER_ 这类特殊用途变量会被忽略。
#    每个 provider 读取 <前缀>_API_KEY 和 <前缀>_FORMAT。
#
#    <前缀>_FORMAT 取值：openai_chat / openai_responses / anthropic
#    可以不填：代码会按 base_url 路径推断（含 /anthropic 或 /messages → anthropic）
#
# 2. Tier：任何 C<数字>_MODEL 会按数字排序自动生成一档（c0..cN），数量不限。
#    每档默认 provider 是 tianhe，可用 C<N>_PROVIDER 覆盖。
# ===========================================================================

# --- Provider 1: tianhe（默认，OpenAI Chat 兼容） ---
BACKEND_BASE_URL=https://chat.tianhe-tech.com/v1
BACKEND_API_KEY=your-tianhe-api-key
BACKEND_FORMAT=openai_chat

# --- Provider 2: starfire（原生 OpenAI Responses） ---
STARFIRE_BASE_URL=http://your-starfire-host/v1
STARFIRE_API_KEY=your-starfire-api-key
STARFIRE_FORMAT=openai_responses

# --- Provider 3: deepseek（Anthropic Messages 兼容，路径含 /anthropic） ---
# 添加任意新 provider 只需复制这三行并换前缀，无需修改 app.py
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_FORMAT=anthropic

# --- Tier 配置：默认 provider 为 tianhe，可用 C<N>_PROVIDER 覆盖 ---
# 例子（4 档，档数不限，可加 C4/C5...）：
C0_MODEL=Qwen3.8-27B
C0_SUPPORTS_IMAGE=1
C0_SUPPORTS_VIDEO=1

C1_PROVIDER=starfire
C1_MODEL=GLM-5.3-Flash
C1_SUPPORTS_IMAGE=1
C1_SUPPORTS_VIDEO=1

C2_PROVIDER=starfire
C2_MODEL=DeepSeek-V4

C3_PROVIDER=deepseek
C3_MODEL=deepseek-flash

# --- Vision 兜底（可选，若请求含图片且无档位支持时使用） ---
# VISION_MODEL=GLM-5.3-Flash
