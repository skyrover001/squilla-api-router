# --- Router service ---
# Global key: admin permissions, including /admin/*.
ROUTER_API_KEY=router-local-key-001
# Optional tenant keys. Tenant keys can call model APIs and are bound to the
# listed tenant; they cannot call /admin/*.
# ROUTER_TENANT_API_KEYS={"team-a":"sk-router-team-a","team-b":"sk-router-team-b"}

# Size-rotated logs. The access log is separate so concurrent rotation is safe.
ROUTER_LOG_ENABLED=1
ROUTER_LOG_LEVEL=INFO
ROUTER_LOG_FILE=squilla_router.log
ROUTER_ACCESS_LOG_FILE=squilla_router_access.log
ROUTER_LOG_MAX_BYTES=20971520
ROUTER_LOG_BACKUP_COUNT=5
# Approximate context tokens charged per image/video capability declaration.
ROUTER_MEDIA_TOKEN_ESTIMATE=1024

# Upstream call bounds (seconds)
BACKEND_TIMEOUT=300
BACKEND_CONNECT_TIMEOUT=30
# Maximum wait for the first streamed content before trying the next tier.
BACKEND_STREAM_START_TIMEOUT=30
# T0/T1 requests use this shorter first-content timeout.
BACKEND_STREAM_FAST_START_TIMEOUT=8
# Maximum idle gap after streaming has started.
BACKEND_STREAM_IDLE_TIMEOUT=300

# Transparent session/task routing (never modifies request content)
ROUTER_SESSION_STICKY=1
ROUTER_TASK_CHANGE_SIMILARITY=0.15
# Production-safe local task-boundary policy. `heuristic` keeps legacy behavior.
ROUTER_TASK_CHANGE_MODE=safe_hybrid
ROUTER_TASK_CHANGE_HARD_THRESHOLD=0.45
ROUTER_TASK_CHANGE_SOFT_THRESHOLD=0.20
# ROUTER_TASK_CHANGE_MODEL=model_bundle/task_change/v1.joblib
ROUTER_COST_AWARE_ENABLED=1
ROUTER_MIN_PROFILE_OBSERVATIONS=3
ROUTER_LARGE_CONTEXT_R2_TOKENS=25000
ROUTER_LARGE_CONTEXT_R3_TOKENS=80000
ROUTER_CIRCUIT_BREAKER_ENABLED=1
ROUTER_FAILURE_COOLDOWN_SECONDS=60
ROUTER_RATE_LIMIT_COOLDOWN_SECONDS=15
ROUTER_STATE_TTL_SECONDS=86400
ROUTER_REPEAT_TOOL_CALL_THRESHOLD=3
# Optional: override the SQLite state path
# ROUTER_STATE_DB=.squilla_router_state.db
# Circuit-breaker state is shared by all processes and survives restart.
# It defaults to ROUTER_STATE_DB, then .squilla_router_state.db.
# ROUTER_CIRCUIT_STATE_DB=.squilla_router_state.db

# ===========================================================================
# Provider / Tier discovery
#
# Canonical: PROVIDER_<NAME>_BASE_URL / _API_KEY / _FORMAT
# C<N>_PROVIDER references the normalized <NAME> exactly.
# Generic <PREFIX>_BASE_URL is accepted with name = lowercase prefix.
# Explicit PROVIDER_* entries win when both forms define the same name.
# FORMAT: openai_chat / openai_responses / anthropic
# ===========================================================================

# --- Provider 1: OpenAI Chat compatible ---
PROVIDER_PRIMARY_BASE_URL=https://your-primary-maas.example/v1
PROVIDER_PRIMARY_API_KEY=your-primary-api-key
PROVIDER_PRIMARY_FORMAT=openai_chat

# --- Provider 2: OpenAI Responses compatible ---
PROVIDER_SECONDARY_BASE_URL=https://your-secondary-maas.example/v1
PROVIDER_SECONDARY_API_KEY=your-secondary-api-key
PROVIDER_SECONDARY_FORMAT=openai_responses

# --- Provider 3: Anthropic Messages compatible ---
PROVIDER_ANTHROPIC_BASE_URL=https://your-anthropic-maas.example
PROVIDER_ANTHROPIC_API_KEY=your-anthropic-api-key
PROVIDER_ANTHROPIC_FORMAT=anthropic

# --- Tiers (unlimited count) ---
C0_PROVIDER=primary
C0_MODEL=your-model-c0
C0_SUPPORTS_IMAGE=1
C0_SUPPORTS_VIDEO=0

C1_PROVIDER=secondary
C1_MODEL=your-model-c1
C1_SUPPORTS_IMAGE=1
C1_SUPPORTS_VIDEO=0

C2_PROVIDER=primary
C2_MODEL=your-model-c2
C2_SUPPORTS_IMAGE=1
C2_SUPPORTS_VIDEO=1

C3_PROVIDER=secondary
C3_MODEL=your-model-c3
C3_SUPPORTS_IMAGE=1
C3_SUPPORTS_VIDEO=0

# Legacy VISION_* fallback is retired. Use C<N>_SUPPORTS_IMAGE/VIDEO.


# ===========================================================================
# 思维强度路由（默认开启；设为 0 可关闭）
#
# 分类器已经给出 T0-T3 思维档，这里把它映射成各模型支持的 effort，
# 再按模型声明的范围或允许集合做 clamp。各家协议的原生写法由 llm-rosetta 自动转换。
# ===========================================================================
ROUTER_REASONING_ENABLED=1
ROUTER_REASONING_PRIORITY=router   # router（自动分类优先）| agent（agent 显式指定优先）
#
# # T0-T3 -> effort（可覆盖）
# THINKING_T0_EFFORT=minimal
# THINKING_T1_EFFORT=low
# THINKING_T2_EFFORT=medium
# THINKING_T3_EFFORT=high
#
# 每个 tier 声明自己的能力；不写 = 该模型不支持思维控制（不下发任何参数）。
# 连续区间用 EFFORT_MIN/MAX；非连续能力用 EFFORTS 白名单。
C0_REASONING_MODES=auto,enabled,disabled
C0_REASONING_EFFORTS=low,medium,xhigh
C0_REASONING_DEFAULT_MODE=auto

C1_REASONING_MODES=auto,enabled,disabled
C1_REASONING_EFFORT_MIN=minimal
C1_REASONING_EFFORT_MAX=max
C1_REASONING_DEFAULT_MODE=auto

C2_REASONING_MODES=auto,enabled,disabled
C2_REASONING_EFFORT_MIN=minimal
C2_REASONING_EFFORT_MAX=max
C2_REASONING_DEFAULT_MODE=auto

C3_REASONING_MODES=auto,enabled,disabled
C3_REASONING_EFFORT_MIN=minimal
C3_REASONING_EFFORT_MAX=max
C3_REASONING_DEFAULT_MODE=auto
