# --- Router service ---
ROUTER_API_KEY=router-local-key-001

# --- Provider 1: tianhe（默认） ---
BACKEND_BASE_URL=https://chat.tianhe-tech.com/v1
BACKEND_API_KEY=your-tianhe-api-key
# Provider 原生 API 格式：openai_chat / openai_responses / anthropic
BACKEND_FORMAT=openai_chat

# --- Provider 2: starfire（若后端只支持 OpenAI Responses） ---
STARFIRE_BASE_URL=http://your-starfire-host/v1
STARFIRE_API_KEY=your-starfire-api-key
STARFIRE_FORMAT=openai_responses

# --- 可选：其他 Provider（如 DeepSeek / OpenRouter） ---
# 添加一个 provider 时复制这一段，改前缀，然后在 tier 里把 provider 字段指向它
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=your-deepseek-key

# --- Tier 配置：每个档位引用 provider（默认 tianhe）+ 模型 + 能力 ---
C0_MODEL=Qwen3.8-27B
C0_SUPPORTS_IMAGE=1
C0_SUPPORTS_VIDEO=1

C1_MODEL=GLM-5.3-Flash
C1_SUPPORTS_IMAGE=1
C1_SUPPORTS_VIDEO=1

C2_MODEL=DeepSeek-V4
C2_SUPPORTS_IMAGE=0
C2_SUPPORTS_VIDEO=0

C3_MODEL=Qwen3.5-397B-A17B
C3_SUPPORTS_IMAGE=1
C3_SUPPORTS_VIDEO=1

# --- Vision 兜底 ---
VISION_MODEL=GLM-5.3-Flash
