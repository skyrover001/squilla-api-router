# --- Router service ---
ROUTER_API_KEY=sk-your-router-key

# --- 统一后端配置 ---
# 如果所有模型都在同一个平台上，BASE_URL 和 API_KEY 用同一个
# 如果分散在不同 provider，每个档位单独填
BACKEND_BASE_URL=https://your-platform.com/v1
BACKEND_API_KEY=sk-your-key

# --- c0: GLM-5.3-Flash（便宜快速，多模态） ---
C0_MODEL=glm-5.3-flash
C0_API_KEY=${BACKEND_API_KEY}
C0_BASE_URL=${BACKEND_BASE_URL}

# --- c1: DeepSeek-V4（MoE 284B/13B，速度快，延迟低） ---
C1_MODEL=deepseek-v4
C1_API_KEY=${BACKEND_API_KEY}
C1_BASE_URL=${BACKEND_BASE_URL}

# --- c2: Qwen3.8-27B（Dense 视觉语言） ---
C2_MODEL=qwen3.8-27b
C2_API_KEY=${BACKEND_API_KEY}
C2_BASE_URL=${BACKEND_BASE_URL}

# --- c3: Qwen3.5-397B-A17B（最大，视觉语言） ---
C3_MODEL=qwen3.5-397b-a17b
C3_API_KEY=${BACKEND_API_KEY}
C3_BASE_URL=${BACKEND_BASE_URL}
